<section class="budget-calculator" aria-labelledby="budget-calculator-title">
  <div class="budget-calculator__intro">
    <p class="eyebrow">Estimation personnalisable</p>
    <h2 id="budget-calculator-title">Calculez votre budget mariage estimatif</h2>
    <p>Choisissez votre nombre d’invités et votre niveau de réception. Le résultat est un repère de préparation, à ajuster avec des devis comparables.</p>
  </div>

  <div class="budget-calculator__controls">
    <label for="budget-guests">Nombre d’invités <output id="budget-guests-output" for="budget-guests">80</output></label>
    <input id="budget-guests" type="range" min="20" max="200" step="5" value="80" aria-describedby="budget-guests-help" />
    <p id="budget-guests-help" class="budget-calculator__help">Le nombre de convives fait évoluer les postes liés au repas, aux boissons et à la papeterie.</p>

    <fieldset>
      <legend>Format de réception</legend>
      <div class="budget-calculator__options">
        <label class="budget-calculator__option"><input type="radio" name="budget-format" value="simple" /><span><strong>Simple et resserré</strong><small>Priorités ciblées, format réduit</small></span></label>
        <label class="budget-calculator__option"><input type="radio" name="budget-format" value="equilibre" checked /><span><strong>Équilibré</strong><small>Réception complète et arbitrages mesurés</small></span></label>
        <label class="budget-calculator__option"><input type="radio" name="budget-format" value="etendu" /><span><strong>Étendu</strong><small>Plus d’options, de durée ou de personnalisation</small></span></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Options à prendre en compte</legend>
      <div class="budget-calculator__checks">
        <label><input type="checkbox" value="video" /> Vidéaste</label>
        <label><input type="checkbox" value="brunch" /> Brunch du lendemain</label>
        <label><input type="checkbox" value="coordination" /> Coordination du jour J</label>
      </div>
    </fieldset>
  </div>

  <div class="budget-calculator__result" aria-live="polite">
    <p class="budget-calculator__result-label">Estimation de votre enveloppe</p>
    <p class="budget-calculator__total" id="budget-total">—</p>
    <p class="budget-calculator__per-guest" id="budget-per-guest">—</p>
    <p class="budget-calculator__notice">Cette estimation n’est ni un devis ni une moyenne nationale. Les tarifs changent selon la région, la date, le lieu et les prestations incluses.</p>
  </div>

  <details class="budget-calculator__details">
    <summary>Voir la répartition indicative</summary>
    <ul id="budget-breakdown"></ul>
  </details>

  <p class="budget-calculator__footnote">Conseil : comparez toujours des devis portant sur le même nombre d’invités, la même durée et les mêmes inclusions.</p>
</section>

<script>
  const root = document.currentScript?.previousElementSibling;

  if (root instanceof HTMLElement) {
    const guestsInput = root.querySelector<HTMLInputElement>('#budget-guests');
    const guestsOutput = root.querySelector<HTMLOutputElement>('#budget-guests-output');
    const totalOutput = root.querySelector<HTMLElement>('#budget-total');
    const perGuestOutput = root.querySelector<HTMLElement>('#budget-per-guest');
    const breakdown = root.querySelector<HTMLUListElement>('#budget-breakdown');
    const optionInputs = root.querySelectorAll<HTMLInputElement>('input[name="budget-format"], input[type="checkbox"]');

    const formats: Record<string, { fixed: number; guest: number }> = {
      simple: { fixed: 5200, guest: 88 },
      equilibre: { fixed: 8800, guest: 145 },
      etendu: { fixed: 15500, guest: 235 },
    };

    const extras: Record<string, { amount?: number; amountPerGuest?: number; label: string }> = {
      video: { amount: 2200, label: 'Vidéaste' },
      brunch: { amountPerGuest: 24, label: 'Brunch du lendemain' },
      coordination: { amount: 1250, label: 'Coordination du jour J' },
    };

    const euro = new Intl.NumberFormat('fr-FR', {
      style: 'currency',
      currency: 'EUR',
      maximumFractionDigits: 0,
    });

    function updateBudget() {
      if (!guestsInput || !guestsOutput || !totalOutput || !perGuestOutput || !breakdown) return;
      const selectedFormat = root.querySelector<HTMLInputElement>('input[name="budget-format"]:checked');
      if (!selectedFormat) return;
      const format = formats[selectedFormat.value];
      if (!format) return;

      const guests = Number(guestsInput.value);
      let total = format.fixed + guests * format.guest;
      const rows: Array<{ label: string; amount: number }> = [
        { label: 'Base de réception et prestations fixes', amount: format.fixed },
        { label: 'Part estimative liée aux invités', amount: guests * format.guest },
      ];

      root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked').forEach((input) => {
        const extra = extras[input.value];
        if (!extra) return;
        const amount = extra.amount ?? (extra.amountPerGuest ?? 0) * guests;
        total += amount;
        rows.push({ label: extra.label, amount });
      });

      guestsOutput.textContent = String(guests);
      totalOutput.textContent = euro.format(total);
      perGuestOutput.textContent = `Environ ${euro.format(Math.round(total / guests))} par invité, tous postes confondus`;
      breakdown.replaceChildren(...rows.map((row) => {
        const item = document.createElement('li');
        const label = document.createElement('span');
        const amount = document.createElement('strong');
        label.textContent = row.label;
        amount.textContent = euro.format(row.amount);
        item.append(label, amount);
        return item;
      }));
    }

    if (guestsInput) guestsInput.addEventListener('input', updateBudget);
    optionInputs.forEach((input) => input.addEventListener('change', updateBudget));
    updateBudget();
  }
</script>
