---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  description: string;
  article?: CollectionEntry<'blog'>;
}

const { title, description, article } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#526D5C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {isHome && <meta name="poprise-verification" content="efLaewLKh5txJ8KBhwJMi49GwrRfM1dTKoB5vOaUrBOLzaNb886tVtzDG8rjIH8g" />}
    <SEOHead title={title} description={description} article={article} />
    <script is:inline src="/analytics-consent.js" defer></script>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <AnalyticsConsent />
  </body>
</html>
