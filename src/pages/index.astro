---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BudgetCalculator from '../components/BudgetCalculator.astro';
import HomeWeddingImage from '../components/HomeWeddingImage.astro';
import HomePodcast from '../components/HomePodcast.astro';
import HomeFaq from '../components/HomeFaq.astro';

const articles = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 9);
---

<BaseLayout title="Top Mariage : Comparatif et calculateur budget mariage" description="Guides pratiques pour organiser votre mariage : budget, lieu, prestataires, tenues et planning.">
  <section class="hero home-hero" aria-labelledby="home-hero-title">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">Préparer sereinement</p>
        <h1 id="home-hero-title">Les bons repères pour organiser un mariage qui vous ressemble.</h1>
        <p class="lead">Top Mariage réunit des guides clairs pour prendre vos décisions dans le bon ordre, de la première idée jusqu’au jour J.</p>
        <a class="button home-hero__cta" href="/blog/">Explorer les guides <span aria-hidden="true">→</span></a>
      </div>
      <figure class="home-hero__photo">
        <img
          src="https://images.pexels.com/photos/7945026/pexels-photo-7945026.jpeg?auto=compress&cs=tinysrgb&w=960&h=720&fit=crop"
          srcset="https://images.pexels.com/photos/7945026/pexels-photo-7945026.jpeg?auto=compress&cs=tinysrgb&w=480&h=360&fit=crop 480w, https://images.pexels.com/photos/7945026/pexels-photo-7945026.jpeg?auto=compress&cs=tinysrgb&w=960&h=720&fit=crop 960w"
          sizes="(max-width: 760px) calc(100vw - 32px), (max-width: 1200px) 44vw, 500px"
          width="960"
          height="720"
          alt="Un couple de mariés s’enlaçant en extérieur"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          referrerpolicy="no-referrer"
        />
        <figcaption>Photo : <a href="https://www.pexels.com/photo/bride-and-groom-embracing-outdoors-7945026/" target="_blank" rel="noopener noreferrer">Jonathan Borba / Pexels</a></figcaption>
      </figure>
    </div>
    <aside class="container home-hero__steps" aria-label="Les grandes étapes">
      <p class="eyebrow">Par où commencer ?</p>
      <ol>
        <li>Définir votre format et vos priorités</li>
        <li>Cadrer votre budget et votre calendrier</li>
        <li>Choisir le lieu et réserver l’essentiel</li>
        <li>Coordonner les derniers détails</li>
      </ol>
    </aside>
  </section>

  <HomePodcast />

  <section class="home-calculator">
    <div class="container">
      <BudgetCalculator />
    </div>
  </section>

  <HomeWeddingImage />

  <section class="section container">
    <div class="section-heading">
      <div><p class="eyebrow">Guides pratiques</p><h2>Avancez étape par étape</h2></div>
      <a class="text-link" href="/blog/">Voir tous les guides <span aria-hidden="true">→</span></a>
    </div>
    {articles.length ? <div class="card-grid">{articles.map((article) => <ArticleCard article={article} />)}</div> : <p>Les premiers guides arrivent bientôt.</p>}
  </section>
  <section class="section section--soft">
    <div class="container split-content">
      <div><p class="eyebrow">Notre approche</p><h2>Moins d’injonctions, plus de méthode.</h2></div>
      <p>Un mariage se prépare rarement en ligne droite. Nos contenus vous aident à hiérarchiser les choix, poser les bonnes questions aux professionnels et conserver une vision simple de votre projet.</p>
    </div>
  </section>
  <section class="section home-author" aria-labelledby="home-author-heading">
    <div class="container home-author__grid">
      <img
        class="home-author__portrait"
        src="/images/coralie-foussard-top-mariage-405.webp"
        width="405"
        height="407"
        alt="Coralie Foussard, créatrice de Top Mariage"
        loading="lazy"
        decoding="async"
      />
      <div class="home-author__copy">
        <p class="eyebrow">Derrière les conseils, une expérience</p>
        <h2 id="home-author-heading">Derrière Top Mariage, Coralie.</h2>
        <p class="home-author__bio">Je suis Coralie, wedding planner indépendante depuis 2015 et créatrice de Top Mariage. J’accompagne des couples en France et en Europe. Ici, je partage mon expérience, des conseils concrets et une vision du mariage sans injonctions. Mon envie : vous aider à faire des choix sereins, sans courir après la journée parfaite. Pour construire, à votre rythme, un mariage qui vous ressemble.</p>
        <a class="button" href="/a-propos/">À la rencontre de Coralie <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <HomeFaq />
  <section class="section home-providers" aria-labelledby="home-providers-heading">
    <div class="container home-providers__inner">
      <div>
        <h2 id="home-providers-heading">Trouvez les bons prestataires</h2>
        <p>Explorez nos <strong>guides et comparatifs</strong> pour repérer les professionnels qui correspondent à vos envies et préparer vos demandes de devis.</p>
      </div>
      <a class="home-providers__button" href="/prestataires-mariage/">Trouver un prestataire <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { padding: clamp(1.5rem, 3.5vw, 3rem) 0 1.5rem; }
  .home-hero__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: clamp(1.5rem, 4vw, 3rem); }
  .home-hero__copy { min-width: 0; }
  .home-hero .eyebrow { margin-bottom: .6rem; }
  .home-hero h1 { max-width: 19ch; margin: 0 0 1rem; font-size: clamp(2rem, 3.8vw, 3.25rem); line-height: 1.1; letter-spacing: -.035em; text-wrap: balance; }
  .home-hero .lead { max-width: 47ch; margin-bottom: 1rem; font-size: clamp(1rem, 1.5vw, 1.1rem); line-height: 1.65; }
  .home-hero__cta { min-height: 48px; margin-top: 0; }
  .home-hero__cta:focus-visible { outline: 2px solid var(--signature); outline-offset: 4px; }
  .home-hero__photo { min-width: 0; margin: 0; }
  .home-hero__photo img { width: 100%; height: auto; max-height: 360px; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 5rem 1rem 5rem 1rem; box-shadow: 0 12px 30px rgba(38, 50, 45, .1); }
  .home-hero__photo figcaption { margin-top: .5rem; text-align: right; font-size: .72rem; color: var(--muted); }
  .home-hero__photo a { text-underline-offset: .2em; }
  .home-hero__steps { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .home-hero__steps ol { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; counter-reset: step; }
  .home-hero__steps li { display: flex; align-items: baseline; gap: .5rem; font-size: .8rem; line-height: 1.5; }
  .home-hero__steps li::before { content: counter(step, decimal-leading-zero); counter-increment: step; color: var(--accent); font-family: var(--serif); font-size: 1.1rem; }
  @media (max-width: 760px) {
    .home-hero { padding-top: 1.25rem; }
    .home-hero__grid { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .home-hero h1 { max-width: 23ch; font-size: clamp(1.85rem, 6.5vw, 2.4rem); margin-bottom: .75rem; }
    .home-hero .lead { max-width: 55ch; margin-bottom: .85rem; font-size: 1rem; line-height: 1.55; }
    .home-hero__photo img { aspect-ratio: 16 / 9; max-height: 230px; border-radius: 2.5rem .75rem 2.5rem .75rem; }
    .home-hero__steps ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-height: 600px) {
    .home-hero { padding-top: .75rem; }
    .home-hero h1 { font-size: clamp(1.65rem, 3.2vw, 2.5rem); margin-bottom: .5rem; }
    .home-hero .lead { margin-bottom: .65rem; line-height: 1.45; }
  }
  .home-providers { background: #0c4023; color: #f1f3f3; }
  .home-providers__inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .home-providers h2 { margin: 0 0 .75rem; color: #f1f3f3; font-size: clamp(1.8rem, 3vw, 2.5rem); }
  .home-providers p { max-width: 62ch; margin: 0; line-height: 1.75; }
  .home-providers__button { display: inline-flex; align-items: center; justify-content: center; gap: .75rem; flex-shrink: 0; min-height: 48px; max-width: 100%; padding: .9rem 1.25rem; border: 1px solid #eb5e55; border-radius: .6rem; background: #eb5e55; color: #1e2424; font-weight: 700; text-decoration: none; box-shadow: 0 4px 18px rgba(235, 94, 85, .25); }
  .home-providers__button:hover { background: #f58279; border-color: #f58279; color: #1e2424; }
  .home-providers__button:focus-visible { outline: 3px solid #f1f3f3; outline-offset: 4px; }
  @media (max-width: 760px) {
    .home-providers__inner { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
    .home-providers__button { width: 100%; }
  }
</style>
