---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import BudgetCalculator from '../../components/BudgetCalculator.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const budgetMetadata = `${post.slug} ${post.data.title} ${post.data.description} ${(post.data.tags ?? []).join(' ')}`
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .toLowerCase();
const showBudgetCalculator = /budget|pas[\s-]+cher|tarifs?|prix|econom/.test(budgetMetadata);
const hasEmbeddedCalculator = /<BudgetCalculator\b/.test(post.body ?? '');
const categoryLabels: Record<typeof post.data.category, string> = {
  'organisation-mariage': 'Organisation du mariage',
  'lieux-mariage': 'Lieux de mariage',
  'prestataires-mariage': 'Prestataires de mariage',
  'robes-tenues': 'Robes et tenues',
};
const related = (await getCollection('blog', ({ data }) => !data.draft && data.category === post.data.category))
  .filter((entry) => entry.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={`${post.data.title} | Top Mariage`} description={post.data.description} article={post}>
  <article>
    <header class="article-header container">
      <Breadcrumbs items={[{ label: 'Guides', href: '/blog/' }, { label: post.data.title }]} />
      <p class="eyebrow">{categoryLabels[post.data.category]}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <p class="article-meta">Publié le <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>{post.data.updatedDate && <> · Mis à jour le <time datetime={post.data.updatedDate.toISOString()}>{post.data.updatedDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time></>}</p>
    </header>
    {showBudgetCalculator && (
      <div class="container article-budget-tool" data-article-budget-tool>
        {!hasEmbeddedCalculator && <BudgetCalculator />}
      </div>
    )}
    <div class="article-content container"><Content /></div>
  </article>
  {related.length > 0 && <section class="section section--soft"><div class="container"><div class="section-heading"><div><p class="eyebrow">À lire aussi</p><h2>Dans la même thématique</h2></div></div><div class="card-grid">{related.map((article) => <ArticleCard article={article} />)}</div></div></section>}
</BaseLayout>

<script>
  function positionArticleBudgetCalculator() {
    document.querySelectorAll<HTMLElement>('[data-article-budget-tool]').forEach((slot) => {
      if (slot.querySelector('.budget-calculator')) return;
      const article = slot.closest('article');
      const embedded = article?.querySelector<HTMLElement>('.article-content .budget-calculator');
      if (embedded) slot.append(embedded);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', positionArticleBudgetCalculator, { once: true });
  } else {
    positionArticleBudgetCalculator();
  }
  document.addEventListener('astro:page-load', positionArticleBudgetCalculator);
</script>
